generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  SYSTEM_ADMIN
  HEADTEACHER
  BURSAR
  TEACHER
  ADMISSIONS
  STOREKEEPER
  TRANSPORT_MANAGER
  DRIVER
  PARENT
  STUDENT
  EXAM_OFFICER
  DIRECTOR
}
enum PaymentChannel {
  MPESA_PAYBILL
  AIRTEL_MONEY
  CHEQUE
  BANK_TRANSFER
  CASH
  IN_KIND
  OTHER
}
enum InKindItem {
  MAIZE
  BEANS
  MILLET
  REAM_PAPER
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TEACHER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdRecords ModuleRecord[] @relation("RecordCreator")
  auditLogs    AuditLog[]
  studentAccount StudentAccount?
  uploadedAssets SchoolAsset[]
  mustChangePassword Boolean @default(false)
  journalEntries JournalEntry[] @relation("JournalCreator")
  uploadedBankTransactions BankTransaction[] @relation("BankUploader")
  schoolLinks SchoolLink[]
  recordedPayments PaymentTransaction[] @relation("PaymentRecorder")
  verifiedPayments PaymentTransaction[] @relation("PaymentVerifier")
  raisedPaymentConcerns PaymentConcern[] @relation("ConcernCreator")
  resolvedPaymentConcerns PaymentConcern[] @relation("ConcernResolver")
  createdInKindPledges InKindPledge[] @relation("PledgeCreator")
  recordedInKindMovements InKindMovement[] @relation("MovementRecorder")
  paymentPrompts PaymentPrompt[] @relation("PaymentPromptCreator")
  salaryRuns SalaryRun[] @relation("SalaryRunCreator")
  confirmedSalaryRuns SalaryRun[] @relation("SalaryRunConfirmer")
  transportAssignments TransportAssignment[] @relation("TransportAssignmentCreator")
}
model Student {
  id            String   @id @default(cuid())
  admissionNo   String   @unique
  firstName     String
  middleName    String?
  lastName      String
  gender        String?
  dateOfBirth   DateTime?
  status        String   @default("ACTIVE")
  admissionDate DateTime @default(now())
  classId       String?
  classRoom     ClassRoom? @relation(fields: [classId], references: [id])
  guardians     GuardianStudent[]
  attendance    Attendance[]
  invoices      Invoice[]
  results       ExamResult[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model Guardian {
  id          String @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  relationship String?
  students    GuardianStudent[]
  createdAt   DateTime @default(now())
}
model GuardianStudent {
  guardianId String
  studentId  String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([guardianId, studentId])
}
model Staff {
  id          String @id @default(cuid())
  staffNo     String @unique
  fullName    String
  phone       String?
  email       String?
  jobTitle    String
  employmentStatus String @default("ACTIVE")
  joinedAt    DateTime?
  createdAt   DateTime @default(now())
}
model ClassRoom {
  id        String @id @default(cuid())
  name      String
  section   String
  stream    String?
  academicYear Int
  students  Student[]
  @@unique([name, section, stream, academicYear])
}
model Subject {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  section   String
}
model Attendance {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String
  remarks   String?
  @@unique([studentId, date])
}
model FeeStructure {
  id          String @id @default(cuid())
  name        String
  section     String
  className   String
  term        String
  academicYear Int
  amount      Decimal @db.Decimal(12,2)
  createdAt   DateTime @default(now())
}
model Invoice {
  id          String @id @default(cuid())
  invoiceNo   String @unique
  studentId   String
  student     Student @relation(fields: [studentId], references: [id])
  description String
  amount      Decimal @db.Decimal(12,2)
  dueDate     DateTime?
  status      String @default("UNPAID")
  payments    Payment[]
  createdAt   DateTime @default(now())
}
model Payment {
  id          String @id @default(cuid())
  receiptNo   String @unique
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  amount      Decimal @db.Decimal(12,2)
  method      String
  reference   String?
  paidAt      DateTime @default(now())
  recordedBy  String?
}
model Expense {
  id          String @id @default(cuid())
  expenseNo  String @unique
  category    String
  description String
  amount      Decimal @db.Decimal(12,2)
  spentAt     DateTime @default(now())
  approvedBy  String?
}
model Assessment {
  id          String @id @default(cuid())
  title       String
  subjectCode String
  className   String
  term        String
  academicYear Int
  maxScore    Decimal @db.Decimal(8,2)
  date        DateTime?
  results     ExamResult[]
}
model ExamResult {
  id           String @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
  score        Decimal @db.Decimal(8,2)
  remarks      String?
  @@unique([assessmentId, studentId])
}
model InventoryItem {
  id          String @id @default(cuid())
  itemCode    String @unique
  name        String
  category    String
  quantity    Int @default(0)
  reorderLevel Int @default(0)
  unit        String @default("pcs")
  updatedAt   DateTime @updatedAt
}
model Supplier {
  id          String @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
}
model Purchase {
  id          String @id @default(cuid())
  supplierId  String?
  description String
  quantity    Int
  totalCost   Decimal @db.Decimal(12,2)
  purchasedAt DateTime @default(now())
  status      String @default("RECORDED")
}
model Vehicle {
  id          String @id @default(cuid())
  registrationNo String @unique
  make        String?
  capacity    Int?
  status      String @default("ACTIVE")
  name        String?
  vehicleClass String @default("BUS")
  routeId     String?
  schoolId    String?
  route       TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  school      School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  assignments TransportAssignment[]
}
model TransportRoute {
  id          String @id @default(cuid())
  name        String
  description String?
  fee         Decimal? @db.Decimal(12,2)
  isActive    Boolean @default(true)
  vehicles    Vehicle[]
  assignments TransportAssignment[]
}
model Announcement {
  id          String @id @default(cuid())
  title       String
  body        String
  audience    String @default("ALL")
  publishedAt DateTime @default(now())
  createdBy   String?
}
model ModuleRecord {
  id        String   @id @default(cuid())
  module    String
  title     String
  data      Json
  createdById String
  createdBy User @relation("RecordCreator", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentAccount StudentAccount?
  photo StudentPhoto?
  feePayments PaymentTransaction[] @relation("PaymentStudent")
  verifiedPaymentRecord PaymentTransaction? @relation("PaymentRecord")
  inKindPledges InKindPledge[]
  inKindMovements InKindMovement[]
  paymentPrompts PaymentPrompt[]
  transportAssignments TransportAssignment[] @relation("AssignedStudent")
  salaryPayments SalaryPayment[]
  @@index([module, createdAt])
}
model StudentAccount {
  id String @id @default(cuid())
  userId String @unique
  recordId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  record ModuleRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  linkedAt DateTime @default(now())
}
model StudentPhoto {
  id String @id @default(cuid())
  recordId String @unique
  fileName String
  mimeType String
  data Bytes
  updatedAt DateTime @updatedAt
  record ModuleRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}
model SchoolAsset {
  id String @id @default(cuid())
  key String @unique
  fileName String
  mimeType String
  data Bytes
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model School {
  id String @id @default(cuid())
  code String @unique
  name String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts LedgerAccount[]
  periods FinancialPeriod[]
  journalEntries JournalEntry[]
  bankTransactions BankTransaction[]
  budgets Budget[]
  directorLinks SchoolLink[]
  payments PaymentTransaction[]
  paymentConcerns PaymentConcern[]
  inKindPledges InKindPledge[]
  inKindMovements InKindMovement[]
  paymentPrompts PaymentPrompt[]
  salaryRuns SalaryRun[]
  transportAssignments TransportAssignment[]
  vehicles Vehicle[]
}
model SchoolLink {
  id String @id @default(cuid())
  directorId String
  schoolId String
  createdAt DateTime @default(now())
  director User @relation(fields: [directorId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@unique([directorId, schoolId])
}
model LedgerAccount {
  id String @id @default(cuid())
  schoolId String
  code String
  name String
  accountType String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lines JournalLine[]
  budgets Budget[]
  @@unique([schoolId, code])
  @@index([schoolId, accountType])
}
model FinancialPeriod {
  id String @id @default(cuid())
  schoolId String
  name String
  startsAt DateTime
  endsAt DateTime
  locked Boolean @default(false)
  lockedAt DateTime?
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  budgets Budget[]
  @@unique([schoolId, name])
  @@index([schoolId, startsAt, endsAt])
}
model JournalEntry {
  id String @id @default(cuid())
  schoolId String
  periodId String?
  entryNumber String
  description String
  sourceType String?
  sourceId String?
  transactionDate DateTime @default(now())
  createdById String
  reversedEntryId String? @unique
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  period FinancialPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdBy User @relation("JournalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines JournalLine[]
  reversedEntry JournalEntry? @relation("JournalReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversal JournalEntry? @relation("JournalReversal")
  bankTransaction BankTransaction?
  paymentTransaction PaymentTransaction?
  salaryRun SalaryRun?
  @@unique([schoolId, entryNumber])
  @@unique([sourceType, sourceId])
  @@index([schoolId, transactionDate])
}
model JournalLine {
  id String @id @default(cuid())
  entryId String
  accountId String
  debit Decimal @default(0) @db.Decimal(14,2)
  credit Decimal @default(0) @db.Decimal(14,2)
  cashbook String @default("MAIN")
  memo String?
  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, entryId])
}
model Budget {
  id String @id @default(cuid())
  schoolId String
  periodId String
  accountId String
  amount Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  period FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([periodId, accountId])
}
model BankTransaction {
  id String @id @default(cuid())
  schoolId String
  uploadedById String?
  externalId String? @unique
  reference String
  admissionNumber String?
  amount Decimal @db.Decimal(14,2)
  method String @default("BANK")
  transactionDate DateTime @default(now())
  status String @default("UNMATCHED")
  conflictReason String?
  rawPayload Json?
  journalEntryId String? @unique
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  uploadedBy User? @relation("BankUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  @@unique([schoolId, reference])
  @@index([schoolId, status, createdAt])
}
model Notification {
  id String @id @default(cuid())
  targetRole String @default("ALL")
  severity String @default("INFO")
  title String
  message String
  entity String?
  entityId String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([targetRole, resolvedAt, createdAt])
}

model PaymentTransaction {
  id String @id @default(cuid())
  schoolId String
  studentRecordId String
  createdById String
  verifiedById String?
  channel PaymentChannel
  transactionCode String?
  idempotencyKey String @unique
  requestFingerprint String
  admissionNumber String
  className String
  allocation String @default("TUITION")
  amount Decimal @default(0) @db.Decimal(14,2)
  cashAmount Decimal @default(0) @db.Decimal(14,2)
  cashbook String @default("BANK")
  item InKindItem?
  quantity Decimal? @db.Decimal(14,3)
  verifiedQuantity Decimal? @db.Decimal(14,3)
  unit String?
  unitValue Decimal? @db.Decimal(14,2)
  inKindValue Decimal @default(0) @db.Decimal(14,2)
  deliveryReference String?
  explanation String?
  status String @default("PENDING_VERIFICATION")
  concern String?
  statementReference String?
  statementAmount Decimal? @db.Decimal(14,2)
  verificationNote String?
  verifiedAt DateTime?
  journalEntryId String? @unique
  paymentRecordId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentRecord ModuleRecord @relation("PaymentStudent", fields: [studentRecordId], references: [id], onDelete: Restrict)
  createdBy User @relation("PaymentRecorder", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  paymentRecord ModuleRecord? @relation("PaymentRecord", fields: [paymentRecordId], references: [id], onDelete: Restrict)
  concerns PaymentConcern[]
  inKindMovement InKindMovement?
  paymentPrompt PaymentPrompt? @relation("PromptSettlement")
  @@unique([schoolId, channel, transactionCode])
  @@index([schoolId, status, createdAt])
  @@index([admissionNumber, createdAt])
}

model PaymentConcern {
  id String @id @default(cuid())
  schoolId String
  paymentId String?
  channel PaymentChannel?
  transactionCode String?
  reason String
  status String @default("OPEN")
  createdById String
  resolvedById String?
  resolutionNote String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User @relation("ConcernCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ConcernResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  @@index([schoolId, status, createdAt])
  @@index([transactionCode, channel])
}

model InKindPledge {
  id String @id @default(cuid())
  schoolId String
  studentRecordId String
  createdById String
  admissionNumber String
  className String
  item InKindItem
  quantity Decimal @db.Decimal(14,3)
  unit String
  unitValue Decimal? @db.Decimal(14,2)
  expectedAt DateTime?
  notes String?
  status String @default("EXPECTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentRecord ModuleRecord @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  createdBy User @relation("PledgeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([schoolId, className, item])
  @@index([admissionNumber, item])
}

model InKindMovement {
  id String @id @default(cuid())
  schoolId String
  paymentId String @unique
  studentRecordId String
  recordedById String
  admissionNumber String
  className String
  item InKindItem
  quantity Decimal @db.Decimal(14,3)
  unit String
  unitValue Decimal? @db.Decimal(14,2)
  totalValue Decimal @default(0) @db.Decimal(14,2)
  receivedAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  studentRecord ModuleRecord @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  recordedBy User @relation("MovementRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([schoolId, className, item, receivedAt])
  @@index([admissionNumber, item])
}

model PaymentPrompt {
  id String @id @default(cuid())
  schoolId String
  studentRecordId String
  createdById String
  gatewayDriver String
  channel PaymentChannel
  purpose String
  allocation String @default("TUITION")
  amount Decimal @db.Decimal(14,2)
  phone String
  explanation String?
  idempotencyKey String @unique
  requestHash String
  providerRequestId String? @unique
  providerReference String? @unique
  callbackIdempotencyKey String? @unique
  status String @default("PENDING_PROMPT")
  failureReason String?
  expiresAt DateTime?
  confirmedAt DateTime?
  settledPaymentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentRecord ModuleRecord @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  createdBy User @relation("PaymentPromptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  settledPayment PaymentTransaction? @relation("PromptSettlement", fields: [settledPaymentId], references: [id], onDelete: Restrict)
  @@index([schoolId, status, createdAt])
  @@index([studentRecordId, createdAt])
}

model TransportAssignment {
  id String @id @default(cuid())
  schoolId String
  studentRecordId String
  vehicleId String
  routeId String?
  assignedById String
  feeAmount Decimal @default(0) @db.Decimal(14,2)
  billingCycle String @default("TERM")
  status String @default("ACTIVE")
  activeKey String? @unique
  assignedAt DateTime @default(now())
  endedAt DateTime?
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentRecord ModuleRecord @relation("AssignedStudent", fields: [studentRecordId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  route TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  assignedBy User @relation("TransportAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  @@index([schoolId, status, vehicleId])
  @@index([studentRecordId, status])
}

model SalaryRun {
  id String @id @default(cuid())
  schoolId String
  createdById String
  confirmedById String?
  gatewayDriver String
  channel PaymentChannel @default(BANK_TRANSFER)
  status String @default("PENDING_CONFIRMATION")
  totalAmount Decimal @db.Decimal(14,2)
  idempotencyKey String @unique
  requestHash String
  providerRequestId String? @unique
  providerReference String? @unique
  callbackIdempotencyKey String? @unique
  journalEntryId String? @unique
  failureReason String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User @relation("SalaryRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User? @relation("SalaryRunConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  items SalaryPayment[]
  @@index([schoolId, status, createdAt])
}

model SalaryPayment {
  id String @id @default(cuid())
  runId String
  staffRecordId String
  amount Decimal @db.Decimal(14,2)
  description String?
  run SalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffRecord ModuleRecord @relation(fields: [staffRecordId], references: [id], onDelete: Restrict)
  @@unique([runId, staffRecordId])
}
