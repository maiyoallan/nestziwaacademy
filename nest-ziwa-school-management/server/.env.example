DATABASE_URL="postgresql://nestziwa:change_this_local_password@localhost:5433/nest_ziwa?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
PORT=5000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
SMTP_URL=""
MAIL_FROM=""
# Optional free-tier hosted chat completion API. Keys remain server-side and are never exposed to Vite.
AI_API_KEY=""
AI_API_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
AI_TIMEOUT_MS=7000
# Optional local model; without a reachable model or AI_API_KEY the built-in read-only assistant works offline.
OLLAMA_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_MODEL="llama3.2"
# Mock mode simulates payment prompts and salary confirmations without moving money.
PAYMENT_GATEWAY_DRIVER="mock_sandbox"
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
# Real provider secrets are not enabled by the included adapter stubs.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
# Optional secret for bank provider POSTs to /api/webhooks/bank.
BANK_WEBHOOK_SECRET=""
